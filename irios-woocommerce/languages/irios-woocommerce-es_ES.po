#: src/Updates.php:102
msgid "Release notes"
msgstr "Notas de la versión"

#: src/Updates.php:104
msgid "Download the zip"
msgstr "Descargar el zip"

#. translators: 1: new version, 2: installed version
#: src/Updates.php:113
#, php-format
msgid "IRIOS Media for WooCommerce %1$s is available (installed: %2$s)."
msgstr "Ya está disponible IRIOS Media for WooCommerce %1$s (instalada: %2$s)."

#: src/Updates.php:142
msgid "The plugin does not update automatically: to update, download the zip and upload it in Plugins → Add New → Upload Plugin (WordPress offers to replace the installed version and the settings are kept)."
msgstr "El plugin no se actualiza solo: para actualizarlo, descarga el zip y súbelo en Plugins → Añadir nuevo → Subir plugin (WordPress ofrece reemplazar la versión instalada y los ajustes se mantienen)."

#: src/Updates.php:145
msgid "Dismiss"
msgstr "Descartar"

#. translators: %s: folder and file of the other copy of the plugin that is active
#: irios-woocommerce.php:36
#, php-format
msgid "IRIOS Media for WooCommerce is not running: another version of the plugin is active (%s). Deactivate it in Plugins; the settings are kept."
msgstr "IRIOS Media for WooCommerce no está funcionando: hay activa otra versión del plugin (%s). Desactívala en Plugins; los ajustes se mantienen."
